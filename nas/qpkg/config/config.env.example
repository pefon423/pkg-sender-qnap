# PS5 PKG Sender native QNAP package configuration.
# Copy is created automatically at <Install_Path>/data/config.env on first install.
# Pre-filled for this NAS/PS5 pair. Only takes effect on a fresh install --
# if <Install_Path>/data/config.env already exists (e.g. from a previous
# install attempt), it is left untouched; remove the package first to pick
# up changes made here.

PKGSENDER_PACKAGE_DIR="/share/PS5"
# Optional. JSON array for multiple library roots. When present, it takes precedence over PKGSENDER_PACKAGE_DIR.
# PKGSENDER_PACKAGE_DIRS='["/share/PS5"]'
PKGSENDER_LISTEN=":9898"
PKGSENDER_PUBLIC_BASE_URL="http://192.168.69.101:9898"
PKGSENDER_PS5_IP="192.168.69.110"
PKGSENDER_PS5_PORT="12800"
# Native QPKG sets this automatically to <Install_Path>/data/aliases.json.
# PKGSENDER_TITLE_ALIASES_FILE="/share/.../.qpkg/PKGSenderNAS/data/aliases.json"
